{
	"name": "@z-commerce/root",
	"type": "module",
	"version": "1.0.0",
	"packageManager": "pnpm@10.33.3",
	"scripts": {
		"build:backend": "pnpm --filter=@z-commerce/backend build",
		"build:frontend": "pnpm --filter=@z-commerce/frontend build",
		"dev:backend": "pnpm --filter=@z-commerce/backend dev",
		"dev:frontend": "pnpm --filter=@z-commerce/frontend dev",
		"inspect:eslint-config": "pnpx @eslint/config-inspector@latest",
		"lint:eslint": "eslint . --max-warnings 0",
		"lint:eslint:interactive": "pnpx eslint-interactive@latest . --fix --max-warnings 0",
		"lint:format": "prettier --write .",
		"lint:type-check": "pnpm -r lint:type-check"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.7.7",
		"@tanstack/eslint-plugin-query": "^5.100.10",
		"@zayne-labs/eslint-config": "^0.13.12",
		"@zayne-labs/prettier-config": "^0.13.12",
		"@zayne-labs/tsconfig": "^0.13.12",
		"eslint": "^10.3.0",
		"eslint-plugin-better-tailwindcss": "^4.5.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"eslint-plugin-react-you-might-not-need-an-effect": "^0.10.1",
		"prettier": "^3.8.3",
		"prettier-plugin-classnames": "^0.10.1",
		"prettier-plugin-merge": "^0.10.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "4.3.0",
		"typescript": "^6.0.3"
	}
}
